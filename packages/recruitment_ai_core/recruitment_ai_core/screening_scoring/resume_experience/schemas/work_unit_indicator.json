              "additionalProperties": false,
              "properties": {
                "indicator_id": {"type": "string", "minLength": 1},
                "level": {"type": "integer", "minimum": 1, "maximum": 5},
                "reason": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          }
        }
      }
    }
  }
}
