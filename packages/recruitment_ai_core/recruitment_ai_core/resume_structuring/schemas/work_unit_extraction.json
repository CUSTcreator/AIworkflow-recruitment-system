{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_units", "context_only_bullet_ids"],
  "properties": {
    "context_only_bullet_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "work_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_refs"],
        "properties": {
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bullet_id"],
              "properties": {
                "bullet_id": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
