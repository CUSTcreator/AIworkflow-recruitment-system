{
  "enabled": false,
  "provider": "openai_compatible",
  "base_url": "https://api.openai.com/v1",
  "api_key": "replace-with-your-api-key",
  "model": "gpt-4.1-mini",
  "timeout_seconds": 60,
  "temperature": 0.1,
  "top_p": 1,
  "json_mode": true,
  "strict_json_schema": false,
  "fail_open": true,
  "workflows": {
    "screening_scoring": {
      "enabled": true
    },
    "job_capability": {
      "enabled": true,
      "temperature": 0,
      "top_p": 1,
      "strict_json_schema": false,
      "timeout_seconds": 120
    },
    "job_document_extraction": {
      "enabled": true,
      "temperature": 0,
      "strict_json_schema": false,
      "timeout_seconds": 120
    },
    "job_document_header_repair": {
      "enabled": true,
      "temperature": 0,
      "strict_json_schema": false,
      "timeout_seconds": 90
    },
    "job_document_field_repair": {
      "enabled": true,
      "temperature": 0,
      "strict_json_schema": false,
      "timeout_seconds": 90
    },
    "resume_document_extraction": {
      "enabled": true,
      "temperature": 0,
      "strict_json_schema": false,
      "timeout_seconds": 120
    },
    "first_interview_planning": {
      "enabled": true
    },
    "post_first_scoring": {
      "enabled": true
    },
    "post_second_scoring": {
      "enabled": true
    }
  },
  "resume_experience": {
    "max_llm_projects": 3,
    "max_llm_calls": 18,
    "max_elapsed_seconds": 120,
    "per_call_timeout_seconds": 20
  },
  "document_parsing": {
    "fallback_to_local": true,
    "mineru": {
      "base_url": "https://mineru.net",
      "api_key": "replace-with-your-mineru-api-key",
      "model_version": "vlm",
      "timeout_seconds": 300,
      "request_timeout_seconds": 30,
      "enable_formula": false,
      "enable_table": true,
      "language": "ch",
      "max_result_bytes": 104857600
    },
    "vision_llm": {
      "enabled": false,
      "base_url": "https://replace-with-your-vision-provider/v1",
      "api_key": "replace-with-your-vision-api-key",
      "model": "replace-with-your-vision-model",
      "timeout_seconds": 180,
      "dpi": 144,
      "max_pages": 20,
      "enable_thinking": false,
      "response_format": "json_object"
    },
    "comparison": {
      "content_recall_threshold": 0.92,
      "reverse_content_recall_threshold": 0.85,
      "critical_token_recall_threshold": 0.98,
      "numeric_token_recall_threshold": 0.98,
      "minimum_length_ratio": 0.75,
      "maximum_length_ratio": 1.3,
      "hard_content_recall_threshold": 0.72,
      "hard_reverse_content_recall_threshold": 0.6,
      "hard_minimum_length_ratio": 0.45,
      "hard_maximum_length_ratio": 2.5
    }
  }
}
