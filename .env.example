# 复制本文件为 .env 后再填写。不要提交包含真实账号、密码或密钥的 .env。

# 运行环境
APP_ENV=development

# PostgreSQL：生产部署时必须修改用户名和密码；密码建议只使用 URL 安全字符。
POSTGRES_DB=recruit_ai
POSTGRES_USER=recruit_ai
POSTGRES_PASSWORD=replace-with-url-safe-database-password

# MinIO 对象存储：生产部署时必须修改管理员账号和密码。
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-at-least-8-characters
MINIO_BUCKET=recruit-ai

# 登录与预置账号：AUTH_SECRET_KEY 必须替换为独立的长随机字符串。
AUTH_SECRET_KEY=replace-with-a-long-random-secret
DEPARTMENT_MANAGER_PASSWORD=replace-with-manager-password
DEPARTMENT_RECRUITER_PASSWORD=replace-with-recruiter-password
HR_PASSWORD=replace-with-hr-password

# 服务地址：按用户实际访问地址填写。VITE_API_BASE_URL 修改后必须重新构建 frontend 镜像。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# 文档解析与日志：没有特殊要求时保留默认值。
DOCUMENT_PARSER_BACKEND=auto
LOG_LEVEL=INFO
OBSERVABILITY_SERVICE_NAME=recruit-ai-backend
METRICS_ENABLED=1

# Importer：IMPORTER_WORKSPACE_DIR 是宿主机上游投放候选人文件夹的目录。
# IMPORTER_USERNAME/PASSWORD 是 Importer 登录招聘系统使用的账号和密码。
# IMPORTER_API_KEY 仅用于保护 Importer 的扫描接口；上游请求头 X-Importer-Api-Key 必须使用相同值。
IMPORTER_WORKSPACE_DIR=./import-data
IMPORTER_USERNAME=hr
IMPORTER_PASSWORD=replace-with-importer-account-password
IMPORTER_API_KEY=replace-with-a-long-random-importer-api-key
